# Copy to .env and fill in. Never commit .env.
# Required for the default setup (Anthropic API, model claude-haiku-5-5):
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-haiku-5-5
# Optional: live OAG schedule for the long-haul share (free tier key). Without it, long haul uses BTS (domestic only)
# and the answer says so.
OAG_API_KEY=
# Optional: use OpenRouter instead of Anthropic directly (LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
